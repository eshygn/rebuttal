# Copy to .env and fill in. Every key is optional: missing keys switch that service to its mock.

# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal (buyer) account email, used in the PayPal-Auth-Assertion header for buyer-side sandbox calls
PAYPAL_SANDBOX_BUYER_EMAIL=
# Optional: buyer-side sandbox transaction IDs the two demo disputes are opened against when PayPal is live
SANDBOX_INR_TRANSACTION_ID=
SANDBOX_SNAD_TRANSACTION_ID=

# Gemini API (aistudio.google.com → Get API key). Free tier is enough.
GOOGLE_GENERATIVE_AI_API_KEY=
# Order: AI_MODEL (default gemini-3.8-flash, the newest Flash) → AI_FALLBACK_MODEL (default gemini-3.5-flash) → recorded responses.
AI_MODEL=
AI_FALLBACK_MODEL=

# Set to 1 to force every service to its mock, even when keys are present
REBUTTAL_MOCK=
# Optional SQLite file location (default: ./data/rebuttal.db)
REBUTTAL_DB_PATH=
